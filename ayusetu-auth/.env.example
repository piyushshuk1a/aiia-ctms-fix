# Copy using: python scripts/init_env.py (generates a local secret; never overwrites .env).
# These settings permit PUBLIC demo credentials and a simulated local outbox.
# Keep this instance isolated and synthetic-only. Never enable these flags for real data.
DEMO_MODE=true
ISOLATED_SYNTHETIC=true
AUTH_SECRET=
APP_ORIGIN=http://127.0.0.1:5173
BIND_HOST=127.0.0.1
COOKIE_SECURE=false
DATABASE_PATH=runtime/ayusetu.sqlite3
ACCESS_SECONDS=900
SESSION_SECONDS=28800
IDLE_SECONDS=1800
REMEMBERED_SECONDS=604800
OTP_ROLES=Admin,PV
OTP_SECONDS=300
OTP_RESEND_SECONDS=30
RESET_SECONDS=900
# Optional configured SMTP delivery; never include actual secrets in shared examples.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
